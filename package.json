{
  "name": "rag-site-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteQA - browser-only RAG question answering over entire websites",
  "scripts": {
    "dev": "vite --config vite.config.chromium.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run build:chromium && npm run build:firefox",
    "build:chromium": "vite build --config vite.config.chromium.ts --outDir dist-chromium",
    "build:firefox": "vite build --config vite.config.firefox.ts --outDir dist-firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^9.9.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.268",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "web-ext": "^8.0.0"
  }
}
